[global]
  frame_color = "#cba6f7"
  separator_color= frame
  highlight = "#89b4fa"
  frame_width = 1

  origin = top-center
  offset = (0, 30)
  width = (100, 300)

[urgency_low]
  background = "#1e1e2e"
  foreground = "#cdd6f4"

[urgency_normal]
  background = "#1e1e2e"
  foreground = "#cdd6f4"

[urgency_critical]
  background = "#1e1e2e"
  foreground = "#cdd6f4"
  frame_color = "#f38ba8"

[play_sound]
  summary = "*"
  script = ~/.config/scripts/notify-sound
