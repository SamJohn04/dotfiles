[user]
    email = samuel.john.codes@gmail.com
    name = Samuel John

[core]
    compression = 9
    whitespace = error
    preloadindex = true

[credential]
    helper = cache

[init]
    defaultBranch = main

[url "git@github.com:SamJohn04/"]
    insteadOf = "sam@gh:"

[url "git@github.com"]
    insteadOf = "gh:"

[status]
    branch = true
    showStash = true
    showUntrackedFiles = all

[diff]
    interHunkContext = 10

[push]
    autoSetupRemote = true
    default = current

[pull]
    default = current
    rebase = true

[rebase]
    autoStash = true
    missingCommitsCheck = warn

