[user]
    email = samuel.john.codes@gmail.com
    name = Samuel John

[credential]
    helper = cache

[init]
    defaultBranch = main

[url "git@github.com:SamJohn04/"]
    insteadOf = "sam:"

[status]
    branch = true
    showStash = true

[diff]
    interHunkContext = 10

[push]
    autoSetupRemote = true
    default = current

[pull]
    default = current
    rebase = true

[rebase]
    autoStash = true
    missingCommitsCheck = warn

